# Copy to .env and adjust for your environment
DATABASE_URL=postgresql+asyncpg://attendance:attendance_dev@localhost:5432/attendance
SECRET_KEY=change-me-to-a-long-random-string-9f2c4b7a1d8e3f0a5b6c7d8e9f0a1b2c
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
APP_NAME=Attendance Tracker
APP_TIMEZONE=Asia/Kolkata

# Email (SMTP) - Set to true to enable email notifications
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Attendance Tracker

# Notification settings
LATE_CHECK_IN_MINUTES=15
SEND_DAILY_REMINDER=true
SEND_LATE_ALERT=true
